<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <Company>Sentinel</Company>
    <Product>Sentinel</Product>
    <Version>0.9.0</Version>
    <Copyright>Sentinel contributors</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Analyzer noise that does not fit this codebase (P/Invoke heavy, culture-invariant telemetry formatting is explicit). -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA2254;CA1716;CA1720;CA1711;CA1724;CA1031;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1308;CA1812;CA1859;CA1822;CA1805;CA1062;CA1515;CA1002;CA1819;CA1815;CA1819;CA1051;CA1034;CA1027;CA1028;CA1008;CA1024;CA1003;CA1063;CA1816;CA2201;CA1866;CA1865;CA1847;CA1806;CA1869;CA1861;CA2000;CA1001;CA1849;CA5394;CA1014;CA1823;CA2101;CA1401;CA1838;CA1060;CA1823;CA1707;CA1725;CA1825;CA1056;CA1054;CA1055;CA1032;CA1064;CA2225;CA1036;CA1050;CA1200;CA1708;CA1721;CA1710;CA1826;CA1863;CA1513;CA1512;CA1510;CA2263;CA1862;CA1868;CA1850;CA2208;CA1052;SYSLIB1054;SYSLIB1096;CS1591</NoWarn>
  </PropertyGroup>
</Project>
