<Window
    x:Class="Sentinel.App.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sentinel.App.Windows"
    Title="Sentinel">

    <Grid x:Name="Root">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="OnSearchAccelerator" />
            <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnSearchAccelerator" />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar -->
        <Grid x:Name="TitleBar" Height="48" Padding="16,0,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="40" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="CaptionInset" Width="140" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image Source="ms-appx:///Assets/Sentinel.png" Width="18" Height="18" />
                <TextBlock Text="Sentinel" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border x:Name="SimulationBadge" Visibility="Collapsed" Background="{ThemeResource SimulationBannerBrush}" CornerRadius="4" Padding="6,1">
                    <TextBlock Text="Developer Simulation" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource SimulationBannerTextBrush}" />
                </Border>
            </StackPanel>
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" MaxWidth="520" MinWidth="200" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                            PlaceholderText="Search or ask Sentinel   (Ctrl+K)" QueryIcon="Find" UpdateTextOnSelect="False"
                            AutomationProperties.Name="Search pages or ask Sentinel a question"
                            TextChanged="OnSearchTextChanged" QuerySubmitted="OnSearchSubmitted" SuggestionChosen="OnSuggestionChosen">
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate x:DataType="local:SearchSuggestion">
                        <StackPanel Orientation="Horizontal" Spacing="12" Padding="0,6">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
                            <StackPanel>
                                <TextBlock Text="{x:Bind Title}" />
                                <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="UpdateButton" Visibility="Collapsed" Click="OnUpdateClicked" VerticalAlignment="Center" Padding="10,4" CornerRadius="12"
                        Background="{ThemeResource AccentFillColorDefaultBrush}" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        BorderThickness="0" AutomationProperties.Name="Update ready. Restart to update Sentinel.">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE777;" FontSize="12" />
                        <TextBlock x:Name="UpdateText" Text="Update ready" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <Button x:Name="RecordingButton" Style="{StaticResource GhostButtonStyle}" Click="OnRecordingClicked" VerticalAlignment="Center"
                        AutomationProperties.Name="Recording status">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse x:Name="RecordingDot" Width="8" Height="8" Fill="{ThemeResource StatusHealthyBrush}" />
                        <TextBlock x:Name="RecordingText" Text="Recording" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <InfoBar x:Name="SimulationBanner" Grid.Row="1" IsOpen="False" IsClosable="False" Severity="Warning" Margin="16,0,16,4"
                 Title="Developer Simulation"
                 Message="All telemetry on this screen is synthetic. Nothing shown describes this PC. Simulation data is stored separately from real history." />

        <NavigationView x:Name="Nav" Grid.Row="2" IsBackButtonVisible="Auto" IsBackEnabled="{x:Bind ContentFrame.CanGoBack, Mode=OneWay}"
                        BackRequested="OnBackRequested" ItemInvoked="OnItemInvoked" IsSettingsVisible="False" PaneDisplayMode="Auto"
                        OpenPaneLength="252" CompactModeThresholdWidth="760" ExpandedModeThresholdWidth="1180" IsTitleBarAutoPaddingEnabled="False">
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="Settings" AutomationProperties.Name="Settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" Navigated="OnNavigated" />
        </NavigationView>
    </Grid>
</Window>
