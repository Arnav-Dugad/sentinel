<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Sentinel design tokens. Every page uses these semantic resources; no page defines its own colours,
        spacing or type sizes. Status colours are always paired with an icon and text (never colour alone).
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="StatusHealthyColor">#FF0F7B45</Color>
            <Color x:Key="StatusAttentionColor">#FFB45309</Color>
            <Color x:Key="StatusCriticalColor">#FFC42B1C</Color>
            <Color x:Key="StatusInfoColor">#FF2563EB</Color>
            <Color x:Key="StatusUnknownColor">#FF6B6B76</Color>
            <Color x:Key="ChartSeries1Color">#FF2563EB</Color>
            <Color x:Key="ChartSeries2Color">#FF0D9488</Color>
            <Color x:Key="ChartSeries3Color">#FFD97706</Color>
            <Color x:Key="ChartSeries4Color">#FF7C3AED</Color>
            <Color x:Key="ChartSeries5Color">#FFDB2777</Color>
            <Color x:Key="ChartSeries6Color">#FF64748B</Color>
            <Color x:Key="ChartGridColor">#14000000</Color>
            <Color x:Key="ChartAxisTextColor">#FF6B6B76</Color>
            <Color x:Key="ChartBandColor">#1FD97706</Color>
            <Color x:Key="HeroGradientStartColor">#142563EB</Color>
            <Color x:Key="HeroGradientEndColor">#000D9488</Color>
            <SolidColorBrush x:Key="StatusHealthyBrush" Color="{StaticResource StatusHealthyColor}" />
            <SolidColorBrush x:Key="StatusAttentionBrush" Color="{StaticResource StatusAttentionColor}" />
            <SolidColorBrush x:Key="StatusCriticalBrush" Color="{StaticResource StatusCriticalColor}" />
            <SolidColorBrush x:Key="StatusInfoBrush" Color="{StaticResource StatusInfoColor}" />
            <SolidColorBrush x:Key="StatusUnknownBrush" Color="{StaticResource StatusUnknownColor}" />
            <SolidColorBrush x:Key="SurfacePrimaryBrush" Color="{ThemeResource LayerFillColorDefault}" />
            <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{ThemeResource LayerFillColorAlt}" />
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{ThemeResource CardBackgroundFillColorDefault}" />
            <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="{ThemeResource CardStrokeColorDefault}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource TextFillColorSecondary}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{ThemeResource TextFillColorTertiary}" />
            <SolidColorBrush x:Key="SimulationBannerBrush" Color="#FFFDE68A" />
            <SolidColorBrush x:Key="SimulationBannerTextBrush" Color="#FF713F12" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="StatusHealthyColor">#FF4ADE80</Color>
            <Color x:Key="StatusAttentionColor">#FFFBBF24</Color>
            <Color x:Key="StatusCriticalColor">#FFF87171</Color>
            <Color x:Key="StatusInfoColor">#FF7AA2FF</Color>
            <Color x:Key="StatusUnknownColor">#FF9A9AA5</Color>
            <Color x:Key="ChartSeries1Color">#FF7AA2FF</Color>
            <Color x:Key="ChartSeries2Color">#FF2DD4BF</Color>
            <Color x:Key="ChartSeries3Color">#FFFBBF24</Color>
            <Color x:Key="ChartSeries4Color">#FFA78BFA</Color>
            <Color x:Key="ChartSeries5Color">#FFF472B6</Color>
            <Color x:Key="ChartSeries6Color">#FF94A3B8</Color>
            <Color x:Key="ChartGridColor">#14FFFFFF</Color>
            <Color x:Key="ChartAxisTextColor">#FF9A9AA5</Color>
            <Color x:Key="ChartBandColor">#29FBBF24</Color>
            <Color x:Key="HeroGradientStartColor">#227AA2FF</Color>
            <Color x:Key="HeroGradientEndColor">#002DD4BF</Color>
            <SolidColorBrush x:Key="StatusHealthyBrush" Color="{StaticResource StatusHealthyColor}" />
            <SolidColorBrush x:Key="StatusAttentionBrush" Color="{StaticResource StatusAttentionColor}" />
            <SolidColorBrush x:Key="StatusCriticalBrush" Color="{StaticResource StatusCriticalColor}" />
            <SolidColorBrush x:Key="StatusInfoBrush" Color="{StaticResource StatusInfoColor}" />
            <SolidColorBrush x:Key="StatusUnknownBrush" Color="{StaticResource StatusUnknownColor}" />
            <SolidColorBrush x:Key="SurfacePrimaryBrush" Color="{ThemeResource LayerFillColorDefault}" />
            <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{ThemeResource LayerFillColorAlt}" />
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{ThemeResource CardBackgroundFillColorDefault}" />
            <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="#14000000" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="{ThemeResource CardStrokeColorDefault}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource TextFillColorSecondary}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{ThemeResource TextFillColorTertiary}" />
            <SolidColorBrush x:Key="SimulationBannerBrush" Color="#FF78350F" />
            <SolidColorBrush x:Key="SimulationBannerTextBrush" Color="#FFFDE68A" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="StatusHealthyColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="StatusAttentionColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="StatusCriticalColor" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="StatusInfoColor" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="StatusUnknownColor" ResourceKey="SystemColorGrayTextColor" />
            <StaticResource x:Key="ChartSeries1Color" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="ChartSeries2Color" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="ChartSeries3Color" ResourceKey="SystemColorHotlightColor" />
            <StaticResource x:Key="ChartSeries4Color" ResourceKey="SystemColorGrayTextColor" />
            <StaticResource x:Key="ChartSeries5Color" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="ChartSeries6Color" ResourceKey="SystemColorGrayTextColor" />
            <StaticResource x:Key="ChartGridColor" ResourceKey="SystemColorGrayTextColor" />
            <StaticResource x:Key="ChartAxisTextColor" ResourceKey="SystemColorWindowTextColor" />
            <Color x:Key="ChartBandColor">#40808080</Color>
            <Color x:Key="HeroGradientStartColor">#00000000</Color>
            <Color x:Key="HeroGradientEndColor">#00000000</Color>
            <SolidColorBrush x:Key="StatusHealthyBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StatusAttentionBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="StatusCriticalBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="StatusInfoBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="StatusUnknownBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="SurfacePrimaryBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceSecondaryBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="SimulationBannerBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SimulationBannerTextBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Spacing (4/8 px system) -->
    <x:Double x:Key="Space1">4</x:Double>
    <x:Double x:Key="Space2">8</x:Double>
    <x:Double x:Key="Space3">12</x:Double>
    <x:Double x:Key="Space4">16</x:Double>
    <x:Double x:Key="Space5">20</x:Double>
    <x:Double x:Key="Space6">24</x:Double>
    <x:Double x:Key="Space8">32</x:Double>
    <x:Double x:Key="ContentMaxWidth">1240</x:Double>
    <Thickness x:Key="PagePadding">32,8,32,40</Thickness>
    <Thickness x:Key="CardPadding">20,16,20,18</Thickness>
    <Thickness x:Key="CompactCardPadding">16,12,16,14</Thickness>

    <!-- Radii -->
    <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">8</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">12</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- Motion -->
    <x:String x:Key="MotionFast">0:0:0.150</x:String>
    <x:String x:Key="MotionNormal">0:0:0.250</x:String>

    <!-- Typography -->
    <Style x:Key="PageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="TextLineBounds" Value="TrimToCapHeight" />
    </Style>
    <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="HeroTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>
    <Style x:Key="SectionTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="EyebrowTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="40" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="MetricValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
    </Style>
    <Style x:Key="MetricSmallValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="LabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="21" />
    </Style>
    <Style x:Key="MutedTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="19" />
    </Style>

    <!-- Surfaces -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLarge}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>
    <Style x:Key="CompactCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="{StaticResource CompactCardPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
    </Style>
    <Style x:Key="SunkenPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceSunkenBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMedium}" />
        <Setter Property="Padding" Value="12,10" />
    </Style>
</ResourceDictionary>
