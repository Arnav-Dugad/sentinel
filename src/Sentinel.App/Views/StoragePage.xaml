<local:SentinelPage
    x:Class="Sentinel.App.Views.StoragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sentinel.App.Views"
    xmlns:vm="using:Sentinel.App.ViewModels"
    xmlns:c="using:Sentinel.App.Controls">

    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <c:PageHeader Title="Storage" Subtitle="Drive health is read through documented, query-only storage interfaces. Sentinel never sends commands to your drives.">
                <c:PageHeader.Actions>
                    <c:RangeSelector SelectedKey="{x:Bind Vm.RangeKey, Mode=TwoWay}" />
                </c:PageHeader.Actions>
            </c:PageHeader>

            <ItemsRepeater ItemsSource="{x:Bind Vm.Drives}">
                <ItemsRepeater.Layout><StackLayout Spacing="16" /></ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:DriveCard">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <c:CardHeader Title="{x:Bind Model}" Subtitle="{x:Bind Subtitle}" Glyph="&#xEDA2;" />
                                    <c:StatusPill Grid.Column="1" Status="{x:Bind Status, Mode=OneWay}" Text="{x:Bind StatusText, Mode=OneWay}" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{x:Bind Summary, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" />
                                <c:AdaptiveGrid MinItemWidth="150" MaxColumns="6" ColumnSpacing="10" RowSpacing="10">
                                    <Border Style="{StaticResource SunkenPanelStyle}" Padding="14,12"><c:MetricTile Chrome="False" Label="Temperature" Value="{x:Bind Temperature, Mode=OneWay}" /></Border>
                                    <Border Style="{StaticResource SunkenPanelStyle}" Padding="14,12"><c:MetricTile Chrome="False" Label="Endurance" Value="{x:Bind Endurance, Mode=OneWay}" /></Border>
                                    <Border Style="{StaticResource SunkenPanelStyle}" Padding="14,12"><c:MetricTile Chrome="False" Label="Read" Value="{x:Bind Read, Mode=OneWay}" /></Border>
                                    <Border Style="{StaticResource SunkenPanelStyle}" Padding="14,12"><c:MetricTile Chrome="False" Label="Write" Value="{x:Bind Write, Mode=OneWay}" /></Border>
                                    <Border Style="{StaticResource SunkenPanelStyle}" Padding="14,12"><c:MetricTile Chrome="False" Label="Active" Value="{x:Bind Active, Mode=OneWay}" /></Border>
                                    <Border Style="{StaticResource SunkenPanelStyle}" Padding="14,12"><c:MetricTile Chrome="False" Label="Response" Value="{x:Bind Latency, Mode=OneWay}" /></Border>
                                </c:AdaptiveGrid>
                                <c:AdaptiveGrid MinItemWidth="360" MaxColumns="2" ColumnSpacing="32" FillLastRow="False">
                                    <c:InfoList Items="{x:Bind Health, Mode=OneWay}" />
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="ENDURANCE HISTORY" Style="{StaticResource EyebrowTextStyle}" FontSize="11" />
                                        <c:Sparkline Points="{x:Bind UsedHistory, Mode=OneWay}" ColorIndex="2" Height="90" Visibility="{x:Bind local:Bool.Trend(UsedHistory), Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind HistoryNote, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                                    </StackPanel>
                                </c:AdaptiveGrid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <c:CardHeader Title="Disk activity" Glyph="&#xE9D2;" />
                    <c:SentinelChart x:Name="Chart" Height="220" AutomationProperties.Name="Disk activity chart" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <c:CardHeader Title="Volumes" Glyph="&#xEDA2;" />
                    <ItemsRepeater ItemsSource="{x:Bind Vm.Volumes}">
                        <ItemsRepeater.Layout><StackLayout Spacing="14" /></ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:VolumeRow">
                                <StackPanel Spacing="6">
                                    <Grid>
                                        <TextBlock FontWeight="SemiBold"><Run Text="{x:Bind Label}" /> (<Run Text="{x:Bind Name}" />)</TextBlock>
                                        <TextBlock Text="{x:Bind Space}" HorizontalAlignment="Right" Style="{StaticResource MutedTextStyle}" />
                                    </Grid>
                                    <ProgressBar Value="{x:Bind UsedPercent}" Maximum="100" />
                                    <TextBlock Style="{StaticResource LabelTextStyle}"><Run Text="{x:Bind FileSystem}" /> · <Run Text="{x:Bind Role}" /> · <Run Text="{x:Bind Encryption}" /></TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</local:SentinelPage>
