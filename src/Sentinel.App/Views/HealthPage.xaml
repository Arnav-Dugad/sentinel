<local:SentinelPage
    x:Class="Sentinel.App.Views.HealthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sentinel.App.Views"
    xmlns:vm="using:Sentinel.App.ViewModels"
    xmlns:c="using:Sentinel.App.Controls">

    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <c:PageHeader Title="System health" Subtitle="{x:Bind Vm.Updated, Mode=OneWay}" />

            <Grid CornerRadius="{StaticResource RadiusLarge}" BorderThickness="1" BorderBrush="{ThemeResource BorderSubtleBrush}" Background="{ThemeResource SurfaceElevatedBrush}">
                <Rectangle RadiusX="8" RadiusY="8">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{ThemeResource HeroGradientStartColor}" Offset="0" />
                            <GradientStop Color="{ThemeResource HeroGradientEndColor}" Offset="0.85" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <StackPanel Padding="28,24,28,26" Spacing="10">
                    <TextBlock Text="{x:Bind Vm.Headline, Mode=OneWay}" Style="{StaticResource HeroTitleTextStyle}" FontSize="26" LineHeight="34" />
                    <TextBlock Text="{x:Bind Vm.Detail, Mode=OneWay}" Style="{StaticResource PageSubtitleTextStyle}" MaxWidth="760" HorizontalAlignment="Left" />
                    <c:StatusPill Status="{x:Bind Vm.Overall, Mode=OneWay}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <c:CardHeader Title="Areas" Subtitle="Each area shows its own status, the confidence behind it and the evidence. Expand one to see why." Margin="0,4,0,-12" />

            <ItemsRepeater ItemsSource="{x:Bind Vm.Categories}">
                <ItemsRepeater.Layout><StackLayout Spacing="10" /></ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:HealthCategoryCard">
                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.Name="{x:Bind Name}">
                            <Expander.Header>
                                <Grid ColumnSpacing="16" Padding="0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="{x:Bind Summary}" Style="{StaticResource LabelTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Confidence}" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center" />
                                        <c:StatusPill Status="{x:Bind Status}" />
                                    </StackPanel>
                                </Grid>
                            </Expander.Header>
                            <StackPanel Spacing="8">
                                <TextBlock Text="Why" Style="{StaticResource EyebrowTextStyle}" />
                                <c:EvidenceList Items="{x:Bind Factors}" />
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</local:SentinelPage>
