<local:SentinelPage
    x:Class="Sentinel.App.Views.SleepPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sentinel.App.Views"
    xmlns:vm="using:Sentinel.App.ViewModels"
    xmlns:c="using:Sentinel.App.Controls">

    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <c:PageHeader Title="Sleep" Subtitle="{x:Bind Vm.Summary, Mode=OneWay}" />

            <c:AdaptiveGrid MinItemWidth="400" MaxColumns="1" ColumnSpacing="16" RowSpacing="16">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <c:CardHeader Title="Sleep sessions on battery (30 days)" Glyph="&#xE708;" Margin="0,0,0,4" />
                        <c:EmptyState Glyph="&#xE708;" Title="No sleep on battery yet"
                                      Message="Sleep drain is measured when this PC sleeps unplugged while Sentinel is running. The next session will appear here."
                                      Visibility="{x:Bind local:Bool.Zero(Vm.Sessions.Count), Mode=OneWay}" />
                        <ItemsRepeater ItemsSource="{x:Bind Vm.Sessions}">
                            <ItemsRepeater.Layout><StackLayout Spacing="2" /></ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:SessionRow">
                                    <Grid ColumnSpacing="12" Padding="0,9" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock><Run Text="{x:Bind When}" /> · <Run Text="{x:Bind Duration}" /></TextBlock>
                                            <TextBlock Text="{x:Bind Note}" Style="{StaticResource LabelTextStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{x:Bind Change}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{x:Bind Power}" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <c:CardHeader Title="Sleep and wake (7 days)" Glyph="&#xE81C;">
                            <c:CardHeader.Actions>
                                <Button Content="Analyze" Command="{x:Bind Vm.AnalyseCommand}" />
                            </c:CardHeader.Actions>
                        </c:CardHeader>
                        <StackPanel Spacing="10" Visibility="{x:Bind local:Bool.Vis(Vm.Diagnosis.HasResult), Mode=OneWay}">
                            <TextBlock Text="{x:Bind Vm.Diagnosis.Summary, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
                            <c:EvidenceList Items="{x:Bind Vm.Diagnosis.Findings, Mode=OneWay}" />
                        </StackPanel>
                        <ItemsRepeater ItemsSource="{x:Bind Vm.Events}">
                            <ItemsRepeater.Layout><StackLayout Spacing="2" /></ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:EventRow">
                                    <Grid ColumnSpacing="14" Padding="0,7" ToolTipService.ToolTip="{x:Bind FullTime}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="132" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="30" Height="30" CornerRadius="15" Background="{ThemeResource SurfaceSunkenBrush}" VerticalAlignment="Top">
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="13" Foreground="{ThemeResource TextSecondaryBrush}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Time}" Style="{StaticResource MutedTextStyle}" Margin="0,5,0,0" TextWrapping="NoWrap" />
                                        <StackPanel Grid.Column="2" Margin="0,5,0,0" Spacing="2">
                                            <TextBlock Text="{x:Bind Title}" />
                                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource LabelTextStyle}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
            </c:AdaptiveGrid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <c:CardHeader Title="About sleep data" Glyph="&#xE946;" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="Sentinel measures sleep drain by comparing the battery's charge just before sleep and just after waking, and reads wake sources from Windows' power log. Which apps hold the PC awake, wake timers and the Sleep Study report are only available to administrators, so Sentinel does not collect them." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</local:SentinelPage>
