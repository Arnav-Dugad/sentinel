<local:SentinelPage
    x:Class="Sentinel.App.Views.WelcomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sentinel.App.Views">

    <Grid>
        <ScrollViewer>
            <Grid MaxWidth="640" Padding="32,48,32,48" VerticalAlignment="Center">
                <StackPanel x:Name="StepOne" Spacing="20">
                    <Image Source="ms-appx:///Assets/Sentinel.png" Width="72" Height="72" HorizontalAlignment="Left" />
                    <StackPanel Spacing="8">
                        <TextBlock Text="Welcome to Sentinel" Style="{StaticResource HeroTitleTextStyle}" />
                        <TextBlock Text="Understand your PC." FontSize="20" Foreground="{ThemeResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodyTextStyle}" FontSize="15" LineHeight="23"
                               Text="Sentinel monitors your computer locally to help explain performance, health and reliability. It learns what is normal for this PC and tells you, calmly and with evidence, when something isn't." />
                    <StackPanel Spacing="10">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE72E;" FontSize="16" Foreground="{ThemeResource StatusHealthyBrush}" />
                            <TextBlock Text="Nothing is uploaded." Style="{StaticResource BodyTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE77B;" FontSize="16" Foreground="{ThemeResource StatusHealthyBrush}" />
                            <TextBlock Text="No account is required." Style="{StaticResource BodyTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8D7;" FontSize="16" Foreground="{ThemeResource StatusHealthyBrush}" />
                            <TextBlock Text="Sentinel will never tune or overclock your hardware, or change your settings." Style="{StaticResource BodyTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Content="Start Sentinel" Style="{StaticResource AccentButtonStyle}" Click="OnStart" HorizontalAlignment="Left" Padding="20,8" Margin="0,8,0,0" />
                </StackPanel>

                <StackPanel x:Name="StepTwo" Spacing="18" Visibility="Collapsed">
                    <TextBlock Text="Optional: local AI" Style="{StaticResource HeroTitleTextStyle}" />
                    <TextBlock Style="{StaticResource BodyTextStyle}" FontSize="15" LineHeight="23"
                               Text="If you use Ollama on this PC, Ask Sentinel can explain its findings in plain conversation. Sentinel's own analysis works fully without it. The model only sees the evidence for your question and can never run commands." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ConnectButton" Content="Connect Ollama" Click="OnConnect" />
                        <Button Content="Skip" Click="OnSkip" />
                    </StackPanel>
                    <ComboBox x:Name="ModelBox" Header="Model" MinWidth="280" Visibility="Collapsed" />
                    <TextBlock x:Name="ConnectStatus" Style="{StaticResource MutedTextStyle}" />
                    <Button x:Name="FinishButton" Content="Finish" Style="{StaticResource AccentButtonStyle}" Click="OnFinish" Visibility="Collapsed" Padding="20,8" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</local:SentinelPage>
