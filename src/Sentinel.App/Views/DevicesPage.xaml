<local:SentinelPage
    x:Class="Sentinel.App.Views.DevicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sentinel.App.Views"
    xmlns:vm="using:Sentinel.App.ViewModels"
    xmlns:c="using:Sentinel.App.Controls">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource ContentMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="20">
            <StackPanel Margin="0,16,0,0" Spacing="12">
                <TextBlock Text="Devices" Style="{StaticResource PageTitleTextStyle}" />
                <SelectorBar x:Name="Sections" SelectionChanged="OnSectionChanged">
                    <SelectorBarItem Text="Devices" IsSelected="True" />
                    <SelectorBarItem Text="Displays" />
                    <SelectorBarItem Text="Audio" />
                    <SelectorBarItem Text="This PC" />
                </SelectorBar>
            </StackPanel>

            <!-- Devices -->
            <StackPanel x:Name="DevicesPanel" Spacing="16">
                <InfoBar IsOpen="{x:Bind local:Bool.Has(Vm.Problems), Mode=OneWay}" IsClosable="False" Severity="Warning" Message="{x:Bind Vm.Problems, Mode=OneWay}" />
                <c:AdaptiveGrid MinItemWidth="400" MaxColumns="2" ColumnSpacing="16" RowSpacing="16">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="External devices" Style="{StaticResource SectionTitleTextStyle}" />
                            <ItemsRepeater ItemsSource="{x:Bind Vm.Devices}">
                                <ItemsRepeater.Layout><StackLayout Spacing="2" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DeviceRow">
                                        <Grid ColumnSpacing="12" Padding="0,7" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource BorderSubtleBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Foreground="{ThemeResource TextSecondaryBrush}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource LabelTextStyle}"><Run Text="{x:Bind Category}" /> · <Run Text="{x:Bind Seen}" /></TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                <TextBlock Text="{x:Bind Status}" HorizontalAlignment="Right" Style="{StaticResource LabelTextStyle}" FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind Battery}" HorizontalAlignment="Right" Style="{StaticResource LabelTextStyle}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Device timeline (7 days)" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="Connections and disconnections appear here as they happen." Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind local:Bool.Zero(Vm.Timeline.Count), Mode=OneWay}" />
                            <ItemsRepeater ItemsSource="{x:Bind Vm.Timeline}">
                                <ItemsRepeater.Layout><StackLayout Spacing="2" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EventRow">
                                        <Grid ColumnSpacing="12" Padding="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Time}" Style="{StaticResource MutedTextStyle}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource LabelTextStyle}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>
                </c:AdaptiveGrid>
            </StackPanel>

            <!-- Displays -->
            <StackPanel x:Name="DisplaysPanel" Spacing="16" Visibility="Collapsed">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Arrangement" Style="{StaticResource SectionTitleTextStyle}" />
                        <Canvas x:Name="Topology" Height="220" AutomationProperties.Name="Display arrangement" />
                        <TextBlock Text="Arranged as Windows positions them. Sentinel never changes display settings." Style="{StaticResource LabelTextStyle}" />
                    </StackPanel>
                </Border>
                <ItemsRepeater ItemsSource="{x:Bind Vm.Displays}">
                    <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="380" MinColumnSpacing="16" MinRowSpacing="16" ItemsStretch="Fill" /></ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:DisplayCard">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource SectionTitleTextStyle}" Margin="0" />
                                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource LabelTextStyle}" />
                                    <c:InfoList Items="{x:Bind Details}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>

            <!-- Audio -->
            <StackPanel x:Name="AudioPanel" Spacing="16" Visibility="Collapsed">
                <c:AdaptiveGrid MinItemWidth="400" MaxColumns="2" ColumnSpacing="16" RowSpacing="16">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Audio devices" Style="{StaticResource SectionTitleTextStyle}" />
                            <ItemsRepeater ItemsSource="{x:Bind Vm.AudioDevices}">
                                <ItemsRepeater.Layout><StackLayout Spacing="2" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AudioRow">
                                        <Grid Padding="0,7" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource BorderSubtleBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource LabelTextStyle}"><Run Text="{x:Bind Kind}" /> · <Run Text="{x:Bind Detail}" /></TextBlock>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Role}" HorizontalAlignment="Right" Style="{StaticResource LabelTextStyle}" FontWeight="SemiBold" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Apps playing sound" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="No app is producing sound right now." Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind local:Bool.Zero(Vm.Sessions.Count), Mode=OneWay}" />
                            <ItemsRepeater ItemsSource="{x:Bind Vm.Sessions}">
                                <ItemsRepeater.Layout><StackLayout Spacing="10" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SessionMeter">
                                        <StackPanel Spacing="4">
                                            <TextBlock><Run Text="{x:Bind Name}" FontWeight="SemiBold" /> · <Run Text="{x:Bind Device}" Foreground="{ThemeResource TextSecondaryBrush}" /></TextBlock>
                                            <ProgressBar Value="{x:Bind Level}" Maximum="100" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="Sentinel reads Windows' volume meters only. It never records audio or listens through a microphone." />
                        </StackPanel>
                    </Border>
                </c:AdaptiveGrid>
            </StackPanel>

            <!-- This PC -->
            <StackPanel x:Name="ComputerPanel" Spacing="16" Visibility="Collapsed">
                <Grid>
                    <TextBlock Text="This PC" Style="{StaticResource SectionTitleTextStyle}" VerticalAlignment="Center" />
                    <ToggleSwitch HorizontalAlignment="Right" IsOn="{x:Bind Vm.Sensitive.ShowSensitive, Mode=TwoWay}" OnContent="Showing identifiers" OffContent="Show sensitive identifiers" MinWidth="0" />
                </Grid>
                <c:AdaptiveGrid MinItemWidth="400" MaxColumns="2" ColumnSpacing="16" RowSpacing="16">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="Computer" Style="{StaticResource SectionTitleTextStyle}" />
                            <c:InfoList Items="{x:Bind Vm.Computer, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Spacing="16">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Security status" Style="{StaticResource SectionTitleTextStyle}" />
                                <c:InfoList Items="{x:Bind Vm.Security, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource LabelTextStyle}" Margin="0,10,0,0" Text="Read-only. Sentinel never turns off or weakens any Windows security feature." />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Manufacturer" Style="{StaticResource SectionTitleTextStyle}" />
                                <c:InfoList Items="{x:Bind Vm.Oem, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Vm.OemStatement, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </c:AdaptiveGrid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</local:SentinelPage>
