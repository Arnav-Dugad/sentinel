<local:SentinelPage
    x:Class="Sentinel.App.Views.TimeMachinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sentinel.App.Views"
    xmlns:vm="using:Sentinel.App.ViewModels"
    xmlns:c="using:Sentinel.App.Controls">

    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <c:PageHeader Title="Time Machine" Subtitle="Pick a moment to see what your PC was doing then." />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <c:CardHeader Title="{x:Bind Vm.MomentLabel, Mode=OneWay}" Glyph="&#xE823;">
                        <c:CardHeader.Actions>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <CalendarDatePicker Date="{x:Bind Vm.Date, Mode=TwoWay}" AutomationProperties.Name="Date" Margin="0,0,8,0" />
                                <Button Content="−1 h" Command="{x:Bind Vm.StepCommand}" CommandParameter="-60" AutomationProperties.Name="Back one hour" />
                                <Button Content="−5 min" Command="{x:Bind Vm.StepCommand}" CommandParameter="-5" AutomationProperties.Name="Back five minutes" />
                                <Button Content="+5 min" Command="{x:Bind Vm.StepCommand}" CommandParameter="5" AutomationProperties.Name="Forward five minutes" />
                                <Button Content="+1 h" Command="{x:Bind Vm.StepCommand}" CommandParameter="60" AutomationProperties.Name="Forward one hour" />
                            </StackPanel>
                        </c:CardHeader.Actions>
                    </c:CardHeader>
                    <c:SentinelChart x:Name="Chart" Height="180" AutomationProperties.Name="Activity on the selected day" />
                    <Slider Minimum="0" Maximum="1439" StepFrequency="1" Value="{x:Bind Vm.Minute, Mode=TwoWay}" AutomationProperties.Name="Time of day" />
                    <TextBlock Text="{x:Bind Vm.Note, Mode=OneWay}" Style="{StaticResource LabelTextStyle}" />
                </StackPanel>
            </Border>

            <c:AdaptiveGrid MinItemWidth="380" MaxColumns="2" ColumnSpacing="16" RowSpacing="16">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <c:CardHeader Title="Hardware at that moment" Glyph="&#xE772;" Margin="0,0,0,6" />
                        <c:EmptyState Glyph="&#xE823;" Title="Nothing recorded" Message="Sentinel has no readings for this moment. History exists only for times Sentinel was running."
                                      Visibility="{x:Bind local:Bool.Zero(Vm.Metrics.Count), Mode=OneWay}" />
                        <ItemsRepeater ItemsSource="{x:Bind Vm.Metrics}">
                            <ItemsRepeater.Layout><StackLayout Spacing="6" /></ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:SnapshotRow">
                                    <Grid ColumnSpacing="12" Padding="0,3" ToolTipService.ToolTip="{x:Bind Source}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Label}" Style="{StaticResource MutedTextStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Value}" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
                <StackPanel Spacing="16">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="6">
                            <c:CardHeader Title="Events within 20 minutes" Glyph="&#xE81C;" Margin="0,0,0,6" />
                            <TextBlock Text="No events were recorded within 20 minutes of this moment." Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind local:Bool.Zero(Vm.Events.Count), Mode=OneWay}" />
                            <ItemsRepeater ItemsSource="{x:Bind Vm.Events}">
                                <ItemsRepeater.Layout><StackLayout Spacing="6" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EventRow">
                                        <Grid ColumnSpacing="12" ToolTipService.ToolTip="{x:Bind FullTime}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind ShortTime}" Style="{StaticResource MutedTextStyle}" TextWrapping="NoWrap" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="6">
                            <c:CardHeader Title="Busiest apps" Glyph="&#xE9F5;" Margin="0,0,0,6" />
                            <TextBlock Text="No app history for this moment (or Privacy mode was on)." Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind local:Bool.Zero(Vm.Apps.Count), Mode=OneWay}" />
                            <ItemsRepeater ItemsSource="{x:Bind Vm.Apps}">
                                <ItemsRepeater.Layout><StackLayout Spacing="6" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AppRow">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="90" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Cpu}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Memory}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </c:AdaptiveGrid>
        </StackPanel>
    </ScrollViewer>
</local:SentinelPage>
