<local:SentinelPage
    x:Class="Sentinel.App.Views.MemoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sentinel.App.Views"
    xmlns:vm="using:Sentinel.App.ViewModels"
    xmlns:c="using:Sentinel.App.Controls">

    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <c:PageHeader Title="Memory" Subtitle="{x:Bind Vm.Summary, Mode=OneWay}">
                <c:PageHeader.Actions>
                    <c:RangeSelector SelectedKey="{x:Bind Vm.RangeKey, Mode=TwoWay}" />
                </c:PageHeader.Actions>
            </c:PageHeader>

            <c:AdaptiveGrid MinItemWidth="190">
                <c:MetricTile Label="In use" Glyph="&#xE964;" Value="{x:Bind Vm.InUse, Mode=OneWay}" Caption="{x:Bind Vm.InUseCaption, Mode=OneWay}" Provenance="GlobalMemoryStatusEx" />
                <c:MetricTile Label="Available" Glyph="&#xE73E;" Value="{x:Bind Vm.Available, Mode=OneWay}" Caption="Free + reclaimable cache" Provenance="GlobalMemoryStatusEx" />
                <c:MetricTile Label="Committed" Glyph="&#xE8B7;" Value="{x:Bind Vm.Committed, Mode=OneWay}" Caption="{x:Bind Vm.CommittedCaption, Mode=OneWay}" Provenance="GetPerformanceInfo" />
                <c:MetricTile Label="Cached" Glyph="&#xE81E;" Value="{x:Bind Vm.Cached, Mode=OneWay}" Caption="Released instantly when needed" Provenance="GetPerformanceInfo" />
                <c:MetricTile Label="Hard faults" Glyph="&#xEDA2;" Value="{x:Bind Vm.HardFaults, Mode=OneWay}" Caption="Pages read back from disk" Provenance="Memory\Page Reads/sec counter" />
            </c:AdaptiveGrid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <c:CardHeader Title="Composition" Glyph="&#xE964;" Margin="0,0,0,2" />
                    <Grid Height="12" CornerRadius="6" ColumnSpacing="3" AutomationProperties.Name="{x:Bind Vm.CompositionText, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{x:Bind Vm.InUseWidth, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Vm.StandbyWidth, Mode=OneWay}" />
                            <ColumnDefinition Width="{x:Bind Vm.FreeWidth, Mode=OneWay}" />
                        </Grid.ColumnDefinitions>
                        <Rectangle>
                            <Rectangle.Fill>
                                <SolidColorBrush Color="{ThemeResource ChartSeries1Color}" />
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Grid.Column="1" Opacity="0.55">
                            <Rectangle.Fill>
                                <SolidColorBrush Color="{ThemeResource ChartSeries2Color}" />
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle Grid.Column="2" Fill="{ThemeResource ControlStrongFillColorDisabledBrush}" Opacity="0.6" />
                    </Grid>
                    <TextBlock Text="{x:Bind Vm.CompositionText, Mode=OneWay}" Style="{StaticResource LabelTextStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <c:CardHeader Title="Usage over time" Glyph="&#xE9D2;" />
                    <c:SentinelChart x:Name="Chart" Height="240" AutomationProperties.Name="Memory chart" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind local:Bool.NonZero(Vm.Growth.Count), Mode=OneWay}">
                <StackPanel Spacing="8">
                    <c:CardHeader Title="Memory growth" Glyph="&#xE9D2;" Margin="0,0,0,4" />
                    <ItemsRepeater ItemsSource="{x:Bind Vm.Growth}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{StaticResource BodyTextStyle}" Margin="0,0,0,8" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <c:AdaptiveGrid MinItemWidth="380" MaxColumns="2" ColumnSpacing="16" RowSpacing="16">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <c:CardHeader Title="Largest memory users" Glyph="&#xE9F5;" Margin="0,0,0,6" />
                        <TextBlock Text="{x:Bind Vm.AppsNote, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind local:Bool.HasText(Vm.AppsNote), Mode=OneWay}" />
                        <ItemsRepeater ItemsSource="{x:Bind Vm.Apps}">
                            <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:AppRow">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Impact}" Style="{StaticResource LabelTextStyle}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Memory}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <c:CardHeader Title="Details" Glyph="&#xE946;" Margin="0,0,0,12" />
                        <c:InfoList Items="{x:Bind Vm.Details, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </c:AdaptiveGrid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <c:CardHeader Title="Memory modules" Glyph="&#xE964;">
                        <c:CardHeader.Actions>
                            <ToggleSwitch IsOn="{x:Bind Vm.Sensitive.ShowSensitive, Mode=TwoWay}" OnContent="Showing identifiers" OffContent="Show sensitive identifiers" MinWidth="0" />
                        </c:CardHeader.Actions>
                    </c:CardHeader>
                    <TextBlock Text="{x:Bind Vm.ModulesNote, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                    <ItemsRepeater ItemsSource="{x:Bind Vm.Modules}">
                        <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ModuleRow">
                                <Border Style="{StaticResource SunkenPanelStyle}">
                                    <Grid ColumnSpacing="16" RowSpacing="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"><Run Text="{x:Bind Capacity}" /> <Run Text="{x:Bind Type}" /> · <Run Text="{x:Bind Speed}" /></TextBlock>
                                            <TextBlock Style="{StaticResource LabelTextStyle}"><Run Text="{x:Bind Manufacturer}" /> · <Run Text="{x:Bind PartNumber}" /> · Serial <Run Text="{x:Bind Serial}" /></TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Slot}" Style="{StaticResource LabelTextStyle}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock Text="Source: SMBIOS (via WMI). Serial numbers stay on this PC and are masked by default." Style="{StaticResource LabelTextStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</local:SentinelPage>
