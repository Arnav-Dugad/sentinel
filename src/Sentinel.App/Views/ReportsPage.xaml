<local:SentinelPage
    x:Class="Sentinel.App.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sentinel.App.Views"
    xmlns:c="using:Sentinel.App.Controls">

    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <c:PageHeader Title="Reports" Subtitle="Create a report on this PC. Reports are saved locally and are never uploaded." />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="14">
                    <ComboBox Header="Report" ItemsSource="{x:Bind Vm.Types}" SelectedIndex="{x:Bind Vm.TypeIndex, Mode=TwoWay}" MinWidth="320" />
                    <ComboBox Header="Format" ItemsSource="{x:Bind Vm.Formats}" SelectedIndex="{x:Bind Vm.FormatIndex, Mode=TwoWay}" MinWidth="160" />
                    <CheckBox Content="Remove personally identifiable information" IsChecked="{x:Bind Vm.PrivacySafe, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="Removes serial numbers, user names, computer name, IP and MAC addresses, personal file paths and GUIDs." />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Create report" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.GenerateCommand}" />
                        <Button Content="Create support bundle (.zip)" Command="{x:Bind Vm.SupportBundleCommand}" />
                        <Button Content="Open reports folder" Command="{x:Bind Vm.OpenFolderCommand}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind Vm.Status, Mode=OneWay}" Style="{StaticResource LabelTextStyle}" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <c:CardHeader Title="Recent reports" Glyph="&#xE9F9;" Margin="0,0,0,4" />
                    <TextBlock Text="None yet." Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind local:Bool.Zero(Vm.Recent.Count), Mode=OneWay}" />
                    <ItemsRepeater ItemsSource="{x:Bind Vm.Recent}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,6" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</local:SentinelPage>
