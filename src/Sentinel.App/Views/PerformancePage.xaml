<local:SentinelPage
    x:Class="Sentinel.App.Views.PerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sentinel.App.Views"
    xmlns:vm="using:Sentinel.App.ViewModels"
    xmlns:c="using:Sentinel.App.Controls">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource ContentMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="20">
            <StackPanel Margin="0,16,0,0" Spacing="8">
                <TextBlock Text="Performance diagnostics" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Investigate slowdowns. Everything here is read-only and runs only when you ask." Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="30-second performance investigation" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="Start this while the slowdown is happening. Sentinel samples every sensor at its highest safe rate for 30 seconds, records which apps were busy, then stops automatically and summarises." />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Start 30-second investigation" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.InvestigateCommand}" IsEnabled="{x:Bind local:Bool.Invert(Vm.Running), Mode=OneWay}" />
                        <Button Content="Save report" Command="{x:Bind Vm.SaveReportCommand}" Visibility="{x:Bind local:Bool.Vis(Vm.HasResult), Mode=OneWay}" />
                    </StackPanel>
                    <ProgressBar Value="{x:Bind Vm.Progress, Mode=OneWay}" Maximum="100" Visibility="{x:Bind local:Bool.Vis(Vm.Running), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Vm.Status, Mode=OneWay}" Style="{StaticResource LabelTextStyle}" />
                </StackPanel>
            </Border>

            <c:AdaptiveGrid MinItemWidth="400" MaxColumns="2" ColumnSpacing="16" RowSpacing="16" Visibility="{x:Bind local:Bool.Vis(Vm.HasResult), Mode=OneWay}">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Findings" Style="{StaticResource SectionTitleTextStyle}" />
                        <c:EvidenceList Items="{x:Bind Vm.Findings, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Measurements" Style="{StaticResource SectionTitleTextStyle}" />
                        <c:InfoList Items="{x:Bind Vm.Metrics, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </c:AdaptiveGrid>

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind local:Bool.Vis(Vm.HasResult), Mode=OneWay}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Busiest apps during the capture" Style="{StaticResource SectionTitleTextStyle}" />
                    <ItemsRepeater ItemsSource="{x:Bind Vm.Contributions}">
                        <ItemsRepeater.Layout><StackLayout Spacing="2" /></ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ContributionRow">
                                <Grid ColumnSpacing="12" Padding="0,6" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource BorderSubtleBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="50" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Cpu}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Memory}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Disk}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Gpu}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Why was my PC slow?" Style="{StaticResource SectionTitleTextStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ComboBox ItemsSource="{x:Bind Vm.Periods}" SelectedIndex="{x:Bind Vm.PeriodIndex, Mode=TwoWay}" MinWidth="200" AutomationProperties.Name="Period" />
                        <Button Content="Analyse" Command="{x:Bind Vm.WhySlowCommand}" />
                    </StackPanel>
                    <StackPanel Spacing="10" Visibility="{x:Bind local:Bool.Vis(Vm.Diagnosis.HasResult), Mode=OneWay}">
                        <TextBlock Text="{x:Bind Vm.Diagnosis.Title, Mode=OneWay}" Style="{StaticResource EyebrowTextStyle}" />
                        <TextBlock Text="{x:Bind Vm.Diagnosis.Summary, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
                        <c:EvidenceList Items="{x:Bind Vm.Diagnosis.Findings, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</local:SentinelPage>
