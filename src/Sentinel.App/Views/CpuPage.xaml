<local:SentinelPage
    x:Class="Sentinel.App.Views.CpuPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sentinel.App.Views"
    xmlns:vm="using:Sentinel.App.ViewModels"
    xmlns:c="using:Sentinel.App.Controls">

    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <c:PageHeader Title="CPU" Subtitle="{x:Bind Vm.Name, Mode=OneWay}" Detail="{x:Bind Vm.Subtitle, Mode=OneWay}">
                <c:PageHeader.Actions>
                    <c:RangeSelector SelectedKey="{x:Bind Vm.RangeKey, Mode=TwoWay}" />
                </c:PageHeader.Actions>
            </c:PageHeader>


            <c:AdaptiveGrid MinItemWidth="190">
                <c:MetricTile Label="Utilization" Glyph="&#xE9D2;" Value="{x:Bind Vm.Utilization, Mode=OneWay}" Caption="All logical processors" Provenance="Windows Processor Information counters (% Processor Utility)" />
                <c:MetricTile Label="Effective clock" Glyph="&#xEC4A;" Value="{x:Bind Vm.Clock, Mode=OneWay}" Caption="{x:Bind Vm.ClockCaption, Mode=OneWay}" Provenance="Base frequency × % Processor Performance (Windows counters)" />
                <c:MetricTile Label="Temperature" Glyph="&#xE9CA;" Value="{x:Bind Vm.Temperature, Mode=OneWay}" Caption="{x:Bind Vm.TemperatureCaption, Mode=OneWay}" />
                <c:MetricTile Label="Package power" Glyph="&#xE945;" Value="{x:Bind Vm.Power, Mode=OneWay}" Caption="{x:Bind Vm.PowerCaption, Mode=OneWay}" />
                <c:MetricTile Label="Performance limit" Glyph="&#xE7BA;" Value="{x:Bind Vm.Limitation, Mode=OneWay}" Caption="Power, thermal or policy limiting" Provenance="Windows counter: 100 − % Performance Limit" />
            </c:AdaptiveGrid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <c:CardHeader Title="Activity" Glyph="&#xE9D2;">
                        <c:CardHeader.Actions>
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <CheckBox Content="Clock" IsChecked="{x:Bind Vm.ShowClock, Mode=TwoWay}" MinWidth="0" />
                                <CheckBox Content="Power" IsChecked="{x:Bind Vm.ShowPower, Mode=TwoWay}" MinWidth="0" />
                                <CheckBox Content="Temperature" IsChecked="{x:Bind Vm.ShowTemperature, Mode=TwoWay}" MinWidth="0" />
                            </StackPanel>
                        </c:CardHeader.Actions>
                    </c:CardHeader>
                    <c:SentinelChart x:Name="Chart" Height="260" AllowZoom="False" AutomationProperties.Name="CPU utilization chart" />
                    <TextBlock Text="Lines other than utilization use their own scale; hover to read exact values. Dashed: performance limitation." Style="{StaticResource LabelTextStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind local:Bool.HasText(Vm.Analysis), Mode=OneWay}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE945;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="Sentinel analysis" Style="{StaticResource EyebrowTextStyle}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind Vm.Analysis, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <c:CardHeader Title="Logical processors" Glyph="&#xE950;" />
                    <ItemsRepeater ItemsSource="{x:Bind Vm.Cores}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="96" MinRowSpacing="8" MinColumnSpacing="8" ItemsStretch="Fill" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:CoreTile">
                                <Border Style="{StaticResource SunkenPanelStyle}">
                                    <StackPanel Spacing="4">
                                        <Grid>
                                            <TextBlock Style="{StaticResource LabelTextStyle}">
                                                <Run Text="CPU" /> <Run Text="{x:Bind Index}" />
                                            </TextBlock>
                                            <TextBlock Text="{x:Bind Kind}" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                        </Grid>
                                        <TextBlock Text="{x:Bind Text, Mode=OneWay}" FontWeight="SemiBold" />
                                        <ProgressBar Value="{x:Bind Utilization, Mode=OneWay}" Maximum="100" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock Text="P = performance core, E = efficiency core (from Windows' core efficiency classes)." Style="{StaticResource LabelTextStyle}" />
                </StackPanel>
            </Border>

            <c:AdaptiveGrid MinItemWidth="380" MaxColumns="2" ColumnSpacing="16" RowSpacing="16">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <c:CardHeader Title="Scheduler" Glyph="&#xE950;" Margin="0,0,0,12" />
                        <c:InfoList Items="{x:Bind Vm.Activity, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <c:CardHeader Title="Processor" Glyph="&#xE950;" Margin="0,0,0,12" />
                        <c:InfoList Items="{x:Bind Vm.Inventory, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </c:AdaptiveGrid>
        </StackPanel>
    </ScrollViewer>
</local:SentinelPage>
