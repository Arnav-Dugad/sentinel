<local:SentinelPage
    x:Class="Sentinel.App.Views.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sentinel.App.Views"
    xmlns:vm="using:Sentinel.App.ViewModels">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource ContentMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="20">
            <StackPanel Margin="0,16,0,0" Spacing="8">
                <TextBlock Text="Startup" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="{x:Bind Vm.Summary, Mode=OneWay}" Style="{StaticResource PageSubtitleTextStyle}" />
                <HyperlinkButton Content="Open Startup Apps settings" NavigateUri="ms-settings:startupapps" Padding="0" />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <ItemsRepeater ItemsSource="{x:Bind Vm.Items}">
                    <ItemsRepeater.Layout><StackLayout Spacing="2" /></ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:StartupRow">
                            <Grid ColumnSpacing="16" Padding="0,9" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource BorderSubtleBrush}" ToolTipService.ToolTip="{x:Bind Target}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource LabelTextStyle}"><Run Text="{x:Bind Publisher}" /> · <Run Text="{x:Bind Location}" /></TextBlock>
                                    <TextBlock Text="{x:Bind Evidence}" Style="{StaticResource LabelTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Status}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{x:Bind Impact}" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Startup changes (30 days)" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Text="No startup items were added or removed." Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind local:Bool.Zero(Vm.Changes.Count), Mode=OneWay}" />
                    <ItemsRepeater ItemsSource="{x:Bind Vm.Changes}">
                        <ItemsRepeater.Layout><StackLayout Spacing="6" /></ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChangeItemRow">
                                <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{x:Bind Time}" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" /></StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="Sentinel never disables startup items. To change one, use Startup Apps in Windows Settings." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</local:SentinelPage>
