<local:SentinelPage
    x:Class="Sentinel.App.Views.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sentinel.App.Views"
    xmlns:c="using:Sentinel.App.Controls"
    xmlns:vm="using:Sentinel.App.ViewModels">

    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <c:PageHeader Title="Startup" Subtitle="{x:Bind Vm.Summary, Mode=OneWay}">
                <c:PageHeader.Footer>
                    <HyperlinkButton Padding="0" Content="Open Startup Apps settings" NavigateUri="ms-settings:startupapps" />
                </c:PageHeader.Footer>
            </c:PageHeader>

            <Border Style="{StaticResource CardStyle}">
                <ItemsRepeater ItemsSource="{x:Bind Vm.Items}">
                    <ItemsRepeater.Layout><StackLayout Spacing="2" /></ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:StartupRow">
                            <Grid ColumnSpacing="14" Padding="0,10" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerBrush}" ToolTipService.ToolTip="{x:Bind Target}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="34" Height="34" CornerRadius="8" Background="{ThemeResource AccentSubtleBrush}" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE7E8;" FontSize="14" Foreground="{ThemeResource AccentGlyphBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource LabelTextStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"><Run Text="{x:Bind Publisher}" /> · <Run Text="{x:Bind Location}" /></TextBlock>
                                    <TextBlock Text="{x:Bind Evidence}" Style="{StaticResource LabelTextStyle}" Visibility="{x:Bind local:Bool.HasText(Evidence)}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                        <Ellipse Width="8" Height="8" Fill="{ThemeResource StatusHealthyBrush}" VerticalAlignment="Center" Visibility="{x:Bind local:Bool.Vis(Enabled)}" />
                                        <Ellipse Width="8" Height="8" Fill="{ThemeResource StatusUnknownBrush}" VerticalAlignment="Center" Visibility="{x:Bind local:Bool.Not(Enabled)}" />
                                        <TextBlock Text="{x:Bind Status}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Impact}" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <c:CardHeader Title="Startup changes (30 days)" Glyph="&#xE81C;" Margin="0,0,0,4" />
                    <TextBlock Text="No startup items were added or removed." Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind local:Bool.Zero(Vm.Changes.Count), Mode=OneWay}" />
                    <ItemsRepeater ItemsSource="{x:Bind Vm.Changes}">
                        <ItemsRepeater.Layout><StackLayout Spacing="6" /></ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChangeItemRow">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Time}" Style="{StaticResource MutedTextStyle}" TextWrapping="NoWrap" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="Sentinel never disables startup items. To change one, use Startup Apps in Windows Settings." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</local:SentinelPage>
