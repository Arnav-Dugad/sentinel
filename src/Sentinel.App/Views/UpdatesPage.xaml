<local:SentinelPage
    x:Class="Sentinel.App.Views.UpdatesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sentinel.App.Views"
    xmlns:vm="using:Sentinel.App.ViewModels"
    xmlns:c="using:Sentinel.App.Controls">

    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <c:PageHeader Title="Updates" Subtitle="Windows Update history, read from the Windows Update Agent. Sentinel never searches for, downloads or installs updates.">
                <c:PageHeader.Footer>
                    <HyperlinkButton Padding="0" Content="Open Windows Update" NavigateUri="ms-settings:windowsupdate" />
                </c:PageHeader.Footer>
            </c:PageHeader>

            <InfoBar IsOpen="{x:Bind Vm.RebootRequired, Mode=OneWay}" Visibility="{x:Bind local:Bool.Vis(Vm.RebootRequired), Mode=OneWay}" IsClosable="False" Severity="Informational" Title="Restart pending"
                     Message="Windows reports that a restart is required to finish installing updates." />

            <c:AdaptiveGrid MinItemWidth="400" MaxColumns="2" ColumnSpacing="16" RowSpacing="16">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <c:CardHeader Title="Last 30 days" Glyph="&#xE9D2;" Margin="0,0,0,12" />
                        <c:InfoList Items="{x:Bind Vm.Counts, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <c:CardHeader Title="Stability around updates" Glyph="&#xE9D5;" Margin="0,0,0,4" />
                        <TextBlock Text="{x:Bind Vm.Correlation, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Border>
            </c:AdaptiveGrid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <c:CardHeader Title="History" Glyph="&#xE81C;">
                        <c:CardHeader.Actions>
                            <ComboBox ItemsSource="{x:Bind Vm.Kinds}" SelectedIndex="{x:Bind Vm.KindIndex, Mode=TwoWay}" MinWidth="240" AutomationProperties.Name="Update type" />
                        </c:CardHeader.Actions>
                    </c:CardHeader>
                    <ItemsRepeater ItemsSource="{x:Bind Vm.Updates}">
                        <ItemsRepeater.Layout><StackLayout Spacing="2" /></ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:UpdateRow">
                                <Grid ColumnSpacing="16" Padding="0,10" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="132" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Date}" Style="{StaticResource MutedTextStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Kind}" Style="{StaticResource LabelTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Result}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</local:SentinelPage>
