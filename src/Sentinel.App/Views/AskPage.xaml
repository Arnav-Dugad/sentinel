<local:SentinelPage
    x:Class="Sentinel.App.Views.AskPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sentinel.App.Views"
    xmlns:vm="using:Sentinel.App.ViewModels"
    xmlns:c="using:Sentinel.App.Controls">

    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <c:PageHeader Title="Ask Sentinel" Subtitle="{x:Bind Vm.AiStatus, Mode=OneWay}" />

            <!-- Composer -->
            <Border Style="{StaticResource CardStyle}" Padding="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8BD;" FontSize="16" Margin="12,0,4,0" Foreground="{ThemeResource AccentGlyphBrush}" VerticalAlignment="Center" />
                    <TextBox x:Name="QuestionBox" Grid.Column="1" MinHeight="40" FontSize="15" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                             PlaceholderText="Ask about temperatures, battery, crashes, storage, memory, drivers, sleep…"
                             Text="{x:Bind Vm.Question, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnKeyDown" AutomationProperties.Name="Question" />
                    <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.AskCommand}" MinHeight="40" Padding="18,0" AutomationProperties.Name="Ask">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}" Width="16" Height="16" Visibility="{x:Bind local:Bool.Vis(Vm.IsBusy), Mode=OneWay}" />
                            <FontIcon Glyph="&#xE724;" FontSize="14" Visibility="{x:Bind local:Bool.Not(Vm.IsBusy), Mode=OneWay}" />
                            <TextBlock Text="Ask" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Thinking -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind local:Bool.Vis(Vm.IsBusy), Mode=OneWay}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="24" Height="24" CornerRadius="6" Background="{ThemeResource AccentSubtleBrush}">
                            <FontIcon Glyph="&#xE945;" FontSize="12" Foreground="{ThemeResource AccentGlyphBrush}" />
                        </Border>
                        <TextBlock Text="Looking through this PC's records…" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" />
                </StackPanel>
            </Border>

            <!-- First run: suggestions -->
            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind local:Bool.Zero(Vm.Answers.Count), Mode=OneWay}">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="10" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Border Width="52" Height="52" CornerRadius="26" Background="{ThemeResource AccentSubtleBrush}" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE8BD;" FontSize="22" Foreground="{ThemeResource AccentGlyphBrush}" />
                        </Border>
                        <TextBlock Text="Ask anything about this PC" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="Answers come from what Sentinel has recorded, with every finding labelled observed, inferred or possible." Style="{StaticResource MutedTextStyle}"
                                   TextAlignment="Center" MaxWidth="520" HorizontalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{x:Bind Vm.Suggestions}" IsTabStop="False" MaxWidth="900">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <c:WrapPanel HorizontalSpacing="8" VerticalSpacing="10" CenterLines="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Content="{x:Bind}" Style="{StaticResource SuggestionButtonStyle}" Click="OnSuggestion" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ItemsRepeater ItemsSource="{x:Bind Vm.Answers}">
                <ItemsRepeater.Layout><StackLayout Spacing="16" /></ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:AnswerCard">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{x:Bind Question}" Style="{StaticResource LabelTextStyle}" FontStyle="Italic" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource SectionTitleTextStyle}" Margin="0" />
                                        <TextBlock Style="{StaticResource LabelTextStyle}"><Run Text="{x:Bind RangeLabel}" /> · <Run Text="{x:Bind Timing}" /></TextBlock>
                                    </StackPanel>
                                    <c:StatusPill Grid.Column="1" Status="{x:Bind ConfidenceStatus}" Text="{x:Bind Confidence}" VerticalAlignment="Top" />
                                </Grid>
                                <TextBlock Text="{x:Bind Summary}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />

                                <Border Style="{StaticResource SunkenPanelStyle}" Visibility="{x:Bind local:Bool.Vis(HasAi)}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Bind AiLabel}" Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Text="{x:Bind AiText}" Style="{StaticResource BodyTextStyle}" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{x:Bind AiNote}" Style="{StaticResource LabelTextStyle}" Visibility="{x:Bind local:Bool.Vis(HasAiNote)}" />

                                <TextBlock Text="Evidence" Style="{StaticResource EyebrowTextStyle}" />
                                <c:EvidenceList Items="{x:Bind Findings}" />
                                <c:InfoList Items="{x:Bind Facts}" Visibility="{x:Bind local:Bool.Vis(HasFacts)}" />

                                <ItemsRepeater ItemsSource="{x:Bind Actions}">
                                    <ItemsRepeater.Layout><StackLayout Spacing="6" /></ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ActionLink">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE7C3;" FontSize="14" />
                                                <TextBlock Text="{x:Bind Text}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                                                <HyperlinkButton Content="{x:Bind Label}" NavigateUri="{x:Bind Uri}" Visibility="{x:Bind local:Bool.Vis(HasUri)}" Padding="4,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>

                                <Expander Header="What Sentinel would share with a local AI" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <TextBlock Text="{x:Bind EvidencePrompt}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</local:SentinelPage>
