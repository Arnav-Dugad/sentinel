<local:SentinelPage
    x:Class="Sentinel.App.Views.AskPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sentinel.App.Views"
    xmlns:vm="using:Sentinel.App.ViewModels"
    xmlns:c="using:Sentinel.App.Controls">

    <Grid MaxWidth="980" Padding="{StaticResource PagePadding}" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,16,0,0" Spacing="8">
            <TextBlock Text="Ask Sentinel" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="{x:Bind Vm.AiStatus, Mode=OneWay}" Style="{StaticResource PageSubtitleTextStyle}" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="10">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="QuestionBox" PlaceholderText="Ask about temperatures, battery, crashes, storage, memory, drivers, sleep…" Text="{x:Bind Vm.Question, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnKeyDown" AutomationProperties.Name="Question" />
                <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.AskCommand}" AutomationProperties.Name="Ask">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing IsActive="{x:Bind Vm.IsBusy, Mode=OneWay}" Width="16" Height="16" Visibility="{x:Bind local:Bool.Vis(Vm.IsBusy), Mode=OneWay}" />
                        <TextBlock Text="Ask" />
                    </StackPanel>
                </Button>
            </Grid>
            <ItemsRepeater ItemsSource="{x:Bind Vm.Suggestions}" Visibility="{x:Bind local:Bool.Zero(Vm.Answers.Count), Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MinItemWidth="280" MinColumnSpacing="8" MinRowSpacing="8" ItemsStretch="Fill" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <Button Content="{x:Bind}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnSuggestion" />
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>

        <ScrollViewer Grid.Row="2">
            <ItemsRepeater ItemsSource="{x:Bind Vm.Answers}">
                <ItemsRepeater.Layout><StackLayout Spacing="16" /></ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:AnswerCard">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{x:Bind Question}" Style="{StaticResource LabelTextStyle}" FontStyle="Italic" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Title}" Style="{StaticResource SectionTitleTextStyle}" Margin="0" />
                                        <TextBlock Style="{StaticResource LabelTextStyle}"><Run Text="{x:Bind RangeLabel}" /> · <Run Text="{x:Bind Timing}" /></TextBlock>
                                    </StackPanel>
                                    <c:StatusPill Grid.Column="1" Status="{x:Bind ConfidenceStatus}" Text="{x:Bind Confidence}" VerticalAlignment="Top" />
                                </Grid>
                                <TextBlock Text="{x:Bind Summary}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />

                                <Border Style="{StaticResource SunkenPanelStyle}" Visibility="{x:Bind local:Bool.Vis(HasAi)}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{x:Bind AiLabel}" Style="{StaticResource EyebrowTextStyle}" />
                                        <TextBlock Text="{x:Bind AiText}" Style="{StaticResource BodyTextStyle}" IsTextSelectionEnabled="True" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="{x:Bind AiNote}" Style="{StaticResource LabelTextStyle}" Visibility="{x:Bind local:Bool.Vis(HasAiNote)}" />

                                <TextBlock Text="Evidence" Style="{StaticResource EyebrowTextStyle}" />
                                <c:EvidenceList Items="{x:Bind Findings}" />
                                <c:InfoList Items="{x:Bind Facts}" Visibility="{x:Bind local:Bool.Vis(HasFacts)}" />

                                <ItemsRepeater ItemsSource="{x:Bind Actions}">
                                    <ItemsRepeater.Layout><StackLayout Spacing="6" /></ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ActionLink">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <FontIcon Glyph="&#xE7C3;" FontSize="14" />
                                                <TextBlock Text="{x:Bind Text}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
                                                <HyperlinkButton Content="{x:Bind Label}" NavigateUri="{x:Bind Uri}" Visibility="{x:Bind local:Bool.Vis(HasUri)}" Padding="4,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>

                                <Expander Header="What Sentinel would share with a local AI" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                    <TextBlock Text="{x:Bind EvidencePrompt}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </Expander>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</local:SentinelPage>
