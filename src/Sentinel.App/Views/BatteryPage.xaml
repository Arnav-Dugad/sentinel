<local:SentinelPage
    x:Class="Sentinel.App.Views.BatteryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sentinel.App.Views"
    xmlns:vm="using:Sentinel.App.ViewModels"
    xmlns:c="using:Sentinel.App.Controls">

    <Grid>
        <c:EmptyState Visibility="{x:Bind local:Bool.Not(Vm.HasBattery), Mode=OneWay}" Glyph="&#xE83F;" VerticalAlignment="Center"
                      Title="This PC has no battery" Message="Battery Lab is available on laptops and tablets. Power and sleep behavior are still shown on the Power and Sleep pages." />
        <ScrollViewer Visibility="{x:Bind local:Bool.Vis(Vm.HasBattery), Mode=OneWay}">
            <StackPanel Style="{StaticResource PageContentStyle}">
                <c:PageHeader Title="Battery Lab" Subtitle="Health, charge sessions and what drains your battery, from the battery's own firmware readings." />

                <c:AdaptiveGrid MinItemWidth="200">
                    <c:MetricTile Label="Charge" Glyph="&#xE83F;" Value="{x:Bind Vm.Percent, Mode=OneWay}" Caption="{x:Bind Vm.State, Mode=OneWay}" Provenance="Remaining capacity reported by the battery's firmware">
                        <c:MetricTile.Footer>
                            <ProgressBar Value="{x:Bind Vm.ChargeValue, Mode=OneWay}" Maximum="100" AutomationProperties.Name="Charge level" />
                        </c:MetricTile.Footer>
                    </c:MetricTile>
                    <c:MetricTile Label="Power" Glyph="&#xE945;" Value="{x:Bind Vm.Rate, Mode=OneWay}" Caption="{x:Bind Vm.RateCaption, Mode=OneWay}" Provenance="Battery charge/discharge rate reported by firmware" />
                    <c:MetricTile Label="Energy remaining" Glyph="&#xE9D2;" Value="{x:Bind Vm.Remaining, Mode=OneWay}" Caption="{x:Bind Vm.RemainingCaption, Mode=OneWay}" />
                    <c:MetricTile Label="Estimated health" Glyph="&#xE95E;" Value="{x:Bind Vm.Health, Mode=OneWay}" Caption="{x:Bind Vm.HealthCaption, Mode=OneWay}"
                                  Provenance="Battery Health = Full Charge Capacity / Design Capacity × 100 (estimate from reported capacities)" />
                </c:AdaptiveGrid>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <c:CardHeader Title="Charge and power" Glyph="&#xE9D2;">
                            <c:CardHeader.Actions>
                                <c:RangeSelector SelectedKey="{x:Bind Vm.RangeKey, Mode=TwoWay}" />
                            </c:CardHeader.Actions>
                        </c:CardHeader>
                        <c:SentinelChart x:Name="Chart" Height="230" AutomationProperties.Name="Battery charge chart" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <c:CardHeader Title="Battery health timeline" Glyph="&#xE83F;" />
                        <c:SentinelChart x:Name="CapacityChart" Height="200" AutomationProperties.Name="Battery capacity history chart" />
                        <TextBlock Text="{x:Bind Vm.CapacityNote, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Import Windows battery history" Command="{x:Bind Vm.ImportReportCommand}" IsEnabled="{x:Bind local:Bool.Invert(Vm.Importing), Mode=OneWay}" />
                            <ProgressRing IsActive="{x:Bind Vm.Importing, Mode=OneWay}" Width="20" Height="20" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Vm.ImportStatus, Mode=OneWay}" Style="{StaticResource LabelTextStyle}" />
                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="Runs Windows' built-in 'powercfg /batteryreport' once, only when you press the button. No administrator rights are needed." />
                    </StackPanel>
                </Border>

                <c:AdaptiveGrid MinItemWidth="380" MaxColumns="2" ColumnSpacing="16" RowSpacing="16">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <c:CardHeader Title="Drain detective" Glyph="&#xE83F;" Margin="0,0,0,2" />
                            <TextBlock Text="{x:Bind Vm.DrainSummary, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
                            <c:EvidenceList Items="{x:Bind Vm.DrainFindings, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <c:CardHeader Title="Battery" Glyph="&#xE83F;" Margin="0,0,0,12" />
                            <c:InfoList Items="{x:Bind Vm.Details, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </c:AdaptiveGrid>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <c:CardHeader Title="Sessions (14 days)" Glyph="&#xE83F;" Margin="0,0,0,4" />
                        <TextBlock Text="Sessions appear as Sentinel observes plugging in, unplugging and sleep." Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind local:Bool.Zero(Vm.Sessions.Count), Mode=OneWay}" />
                        <ItemsRepeater ItemsSource="{x:Bind Vm.Sessions}">
                            <ItemsRepeater.Layout><StackLayout Spacing="4" /></ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:SessionRow">
                                    <Grid ColumnSpacing="14" Padding="0,6" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource BorderSubtleBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource TextSecondaryBrush}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock><Run Text="{x:Bind Kind}" FontWeight="SemiBold" /> · <Run Text="{x:Bind When}" /></TextBlock>
                                            <TextBlock Text="{x:Bind Note}" Style="{StaticResource LabelTextStyle}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                            <TextBlock HorizontalAlignment="Right"><Run Text="{x:Bind Change}" /> · <Run Text="{x:Bind Duration}" /></TextBlock>
                                            <TextBlock Text="{x:Bind Power}" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:SentinelPage>
