<local:SentinelPage
    x:Class="Sentinel.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sentinel.App.Views"
    xmlns:vm="using:Sentinel.App.ViewModels">

    <Page.Resources>
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="ColumnSpacing" Value="24" />
            <Setter Property="Padding" Value="0,10" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel MaxWidth="980" Padding="{StaticResource PagePadding}" Spacing="20">
            <StackPanel Margin="0,16,0,0" Spacing="8">
                <TextBlock Text="Settings" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Sentinel is read-only and fully local. Nothing here can change your hardware or Windows configuration." Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <InfoBar IsOpen="{x:Bind Vm.HasMessage, Mode=OneWay}" Message="{x:Bind Vm.Message, Mode=OneWay}" Severity="Informational" IsClosable="False" />
            <InfoBar IsOpen="{x:Bind Vm.RestartNeeded, Mode=OneWay}" Severity="Warning" Title="Restart required" Message="Developer simulation changes take effect after restarting Sentinel." IsClosable="False">
                <InfoBar.ActionButton>
                    <Button Content="Restart now" Command="{x:Bind Vm.RestartCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Updates -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Updates" Style="{StaticResource SectionTitleTextStyle}" />
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Grid Width="40" Height="40" CornerRadius="20" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Top">
                            <FontIcon Glyph="{x:Bind Vm.Updates.Glyph, Mode=OneWay}" FontSize="18" />
                            <ProgressRing IsActive="{x:Bind Vm.Updates.IsChecking, Mode=OneWay}" Width="40" Height="40" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Vm.Updates.Status, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="{x:Bind Vm.Updates.Detail, Mode=OneWay}" Style="{StaticResource LabelTextStyle}" TextWrapping="Wrap"
                                       Visibility="{x:Bind local:Bool.HasText(Vm.Updates.Detail), Mode=OneWay}" />
                            <TextBlock Text="{x:Bind Vm.Updates.LastInstallSummary, Mode=OneWay}" Style="{StaticResource LabelTextStyle}" TextWrapping="Wrap"
                                       Visibility="{x:Bind local:Bool.HasText(Vm.Updates.LastInstallSummary), Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Restart and update" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.InstallUpdateCommand}"
                                    Visibility="{x:Bind local:Bool.Vis(Vm.Updates.CanRestart), Mode=OneWay}" />
                            <Button Content="Download" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind Vm.DownloadUpdateCommand}"
                                    Visibility="{x:Bind local:Bool.Vis(Vm.Updates.CanDownload), Mode=OneWay}" />
                            <Button Content="Check for updates" Command="{x:Bind Vm.CheckUpdatesCommand}"
                                    IsEnabled="{x:Bind local:Bool.Invert(Vm.Updates.IsBusy), Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar Value="{x:Bind Vm.Updates.Progress, Mode=OneWay}" Maximum="100" Visibility="{x:Bind local:Bool.Vis(Vm.Updates.IsDownloading), Mode=OneWay}"
                                 AutomationProperties.Name="Update download progress" />
                    <Expander Header="{x:Bind local:Text.WhatsNew(Vm.Updates.NewVersion), Mode=OneWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                              Visibility="{x:Bind local:Bool.HasText(Vm.Updates.Notes), Mode=OneWay}">
                        <TextBlock Text="{x:Bind Vm.Updates.Notes, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource BodyTextStyle}" />
                    </Expander>
                    <ToggleSwitch Header="Check for updates automatically" IsOn="{x:Bind Vm.CheckForUpdates, Mode=TwoWay}" />
                    <ToggleSwitch Header="Download updates in the background and install them when Sentinel restarts" IsOn="{x:Bind Vm.InstallUpdatesAutomatically, Mode=TwoWay}"
                                  IsEnabled="{x:Bind Vm.Updates.CanInstall}" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap"
                               Text="{x:Bind Vm.Updates.InstallBlockedReason}" Visibility="{x:Bind local:Bool.HasText(Vm.Updates.InstallBlockedReason)}" />
                    <TextBlock Style="{StaticResource LabelTextStyle}" TextWrapping="Wrap">
                        <Run Text="Updates come only from the official GitHub releases and are installed only if their signature matches Sentinel's release key (" /><Run Text="{x:Bind Vm.Updates.KeyFingerprint}" FontFamily="Consolas" /><Run Text="). Checking sends GitHub a standard web request and nothing else." />
                    </TextBlock>
                    <HyperlinkButton Content="All releases on GitHub" Command="{x:Bind Vm.OpenReleasesCommand}" Padding="0" />
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Appearance and units" Style="{StaticResource SectionTitleTextStyle}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Theme" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1" MinWidth="220" ItemsSource="{x:Bind Vm.Themes}" SelectedIndex="{x:Bind Vm.ThemeIndex, Mode=TwoWay}" AutomationProperties.Name="Theme" />
                    </Grid>
                    <ToggleSwitch Header="Temperatures in Fahrenheit" IsOn="{x:Bind Vm.Fahrenheit, Mode=TwoWay}" />
                    <ToggleSwitch Header="Network speeds in bits per second (Mbps)" IsOn="{x:Bind Vm.Bits, Mode=TwoWay}" />
                    <ToggleSwitch Header="Decimal byte units (GB instead of GiB)" IsOn="{x:Bind Vm.DecimalBytes, Mode=TwoWay}" />
                    <ToggleSwitch Header="Reduce motion" IsOn="{x:Bind Vm.ReduceMotion, Mode=TwoWay}" />
                    <TextBlock Text="Decorative animation also pauses automatically when Windows animations are off or Battery Saver is on." Style="{StaticResource LabelTextStyle}" />
                </StackPanel>
            </Border>

            <!-- Behaviour -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Behavior" Style="{StaticResource SectionTitleTextStyle}" />
                    <ToggleSwitch Header="Keep running in the notification area when the window is closed" IsOn="{x:Bind Vm.CloseToTray, Mode=TwoWay}" />
                    <ToggleSwitch Header="Start Sentinel when I sign in" IsOn="{x:Bind Vm.StartWithWindows, Mode=TwoWay}" />
                    <ToggleSwitch Header="Notifications for significant issues" IsOn="{x:Bind Vm.Notifications, Mode=TwoWay}" />
                    <TextBlock Text="Notifications are rare by design: at most one per topic per day and three per day overall, only for things like repeated crashes, critical drive health or abnormal sleep drain." Style="{StaticResource LabelTextStyle}" />
                </StackPanel>
            </Border>

            <!-- History -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="History and storage" Style="{StaticResource SectionTitleTextStyle}" />
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Keep long-term history for" />
                            <TextBlock Text="Detailed 10-second samples are kept for 48 hours and minute averages for up to 21 days; hourly summaries follow this setting." Style="{StaticResource LabelTextStyle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" MinWidth="220" ItemsSource="{x:Bind Vm.Retentions}" SelectedIndex="{x:Bind Vm.RetentionIndex, Mode=TwoWay}" AutomationProperties.Name="History retention" />
                    </Grid>
                    <Grid Style="{StaticResource SettingRow}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Database size" />
                            <TextBlock Text="{x:Bind Vm.DatabasePath, Mode=OneWay}" Style="{StaticResource LabelTextStyle}" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{x:Bind Vm.DatabaseSize, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                    <ToggleSwitch Header="Pause history recording" IsOn="{x:Bind Vm.RecordingPaused, Mode=TwoWay}" />
                    <ToggleSwitch Header="Record per-application usage history" IsOn="{x:Bind Vm.RecordAppHistory, Mode=TwoWay}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="Open data folder" Command="{x:Bind Vm.OpenDataFolderCommand}" />
                        <Button Content="Delete all history…" Click="OnClearHistory" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Privacy -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="Privacy" Style="{StaticResource SectionTitleTextStyle}" />
                    <ToggleSwitch Header="Privacy mode" IsOn="{x:Bind Vm.PrivacyMode, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="Privacy mode stops collecting application names and process history and hides them from insights and Ask Sentinel. Hardware telemetry continues." />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Margin="0,8,0,0" Text="Always true: no account, no cloud, no analytics, no advertising. Serial numbers, UUIDs, MAC and IP addresses are masked until you choose to reveal them, and exports remove them by default." />
                    <Button Content="Export diagnostic log (redacted)" Command="{x:Bind Vm.ExportLogCommand}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Local AI -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Local AI (optional)" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="Sentinel's analysis works without AI. If you run Ollama on this PC, Ask Sentinel can use it to explain results in conversational language. The model only receives the redacted evidence for your question, has no tools, and can never run commands or change settings." />
                    <ToggleSwitch Header="Enable Ollama" IsOn="{x:Bind Vm.OllamaEnabled, Mode=TwoWay}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Header="Endpoint" Text="{x:Bind Vm.OllamaEndpoint, Mode=TwoWay}" />
                        <Button Grid.Column="1" Content="Test connection" VerticalAlignment="Bottom" Command="{x:Bind Vm.TestOllamaCommand}" />
                    </Grid>
                    <ComboBox Header="Model" MinWidth="280" ItemsSource="{x:Bind Vm.Models}" SelectedItem="{x:Bind Vm.OllamaModel, Mode=TwoWay}" PlaceholderText="Test the connection to list installed models" />
                    <TextBlock Text="{x:Bind Vm.OllamaStatus, Mode=OneWay}" Style="{StaticResource LabelTextStyle}" />
                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="Lightweight models (under ~4B parameters) answer fastest; balanced (4–10B) are a good default; advanced (10B+) need more memory. Sentinel never downloads models." />
                </StackPanel>
            </Border>

            <!-- Providers -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Telemetry providers" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="Every provider is read-only and must pass Sentinel's safety contract before it runs. Turning one off stops its collection immediately." />
                    <ItemsRepeater ItemsSource="{x:Bind Vm.Providers}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="2" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProviderRow">
                                <Grid ColumnSpacing="16" Padding="0,10" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource BorderSubtleBrush}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock FontWeight="SemiBold"><Run Text="{x:Bind Name}" /><Run Text="  ·  " Foreground="{ThemeResource TextSecondaryBrush}" /><Run Text="{x:Bind Category}" Foreground="{ThemeResource TextSecondaryBrush}" /></TextBlock>
                                        <TextBlock Text="{x:Bind Status, Mode=OneWay}" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{x:Bind Sources}" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource LabelTextStyle}" />
                                        <TextBlock Text="{x:Bind Unavailable, Mode=OneWay}" Style="{StaticResource LabelTextStyle}" FontStyle="Italic" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Enabled, Mode=TwoWay}" OnContent="On" OffContent="Off" MinWidth="0" AutomationProperties.Name="{x:Bind Name}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <!-- Developer -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Developer" Style="{StaticResource SectionTitleTextStyle}" />
                    <ToggleSwitch Header="Developer simulation (synthetic telemetry)" IsOn="{x:Bind Vm.Simulation, Mode=TwoWay}" />
                    <ComboBox Header="Scenario" MinWidth="240" ItemsSource="{x:Bind Vm.Scenarios}" SelectedIndex="{x:Bind Vm.ScenarioIndex, Mode=TwoWay}" />
                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="Simulation is for testing Sentinel without specific hardware. It is always labelled on screen and uses a separate database." />
                </StackPanel>
            </Border>

            <!-- About -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="About Sentinel" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Style="{StaticResource MutedTextStyle}"><Run Text="Version " /><Run Text="{x:Bind Vm.Version}" /></TextBlock>
                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="Observe everything safely. Understand what is happening. Learn what is normal. Detect what is unusual. Explain why it matters." />
                    <TextBlock Text="Sentinel's own resource use" Style="{StaticResource LabelTextStyle}" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <StackPanel>
                            <TextBlock Text="{x:Bind Vm.FootprintCpu, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="CPU" Style="{StaticResource LabelTextStyle}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{x:Bind Vm.FootprintMemory, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="Private memory" Style="{StaticResource LabelTextStyle}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{x:Bind Vm.DatabaseSize, Mode=OneWay}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="History database" Style="{StaticResource LabelTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{x:Bind Vm.FootprintDetail, Mode=OneWay}" Style="{StaticResource LabelTextStyle}" TextWrapping="Wrap" />
                    <TextBlock Text="Safety contract — every data provider must be:" Style="{StaticResource LabelTextStyle}" Margin="0,8,0,0" />
                    <ItemsRepeater ItemsSource="{x:Bind Vm.SafetyClauses}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{StaticResource MutedTextStyle}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</local:SentinelPage>
