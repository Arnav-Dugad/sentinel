<local:SentinelPage
    x:Class="Sentinel.App.Views.ThermalsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sentinel.App.Views"
    xmlns:vm="using:Sentinel.App.ViewModels"
    xmlns:c="using:Sentinel.App.Controls">

    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <c:PageHeader Title="Thermals" Subtitle="Every temperature Sentinel can read safely, with its source. Overlaying load and power shows cause and effect.">
                <c:PageHeader.Actions>
                    <c:RangeSelector SelectedKey="{x:Bind Vm.RangeKey, Mode=TwoWay}" />
                </c:PageHeader.Actions>
            </c:PageHeader>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <c:CardHeader Title="Thermal timeline" Glyph="&#xE9D2;">
                        <c:CardHeader.Actions>
                            <Button Content="Why is my PC hot?" Command="{x:Bind Vm.DiagnoseCommand}" />
                        </c:CardHeader.Actions>
                    </c:CardHeader>
                    <c:SentinelChart x:Name="Chart" Height="280" AutomationProperties.Name="Thermal timeline" />
                    <TextBlock Text="Temperatures share the left scale; load and power use their own scales. Hover to compare values at the same moment." Style="{StaticResource LabelTextStyle}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Visibility="{x:Bind local:Bool.Vis(Vm.HasDiagnosis), Mode=OneWay}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Bind Vm.DiagnosisTitle, Mode=OneWay}" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="{x:Bind Vm.DiagnosisSummary, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
                    <c:EvidenceList Items="{x:Bind Vm.DiagnosisFindings, Mode=OneWay}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <c:CardHeader Title="Sensors" Glyph="&#xE9CA;" Margin="0,0,0,4" />
                    <ItemsRepeater ItemsSource="{x:Bind Vm.Sensors}">
                        <ItemsRepeater.Layout><StackLayout Spacing="2" /></ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:SensorRow">
                                <Grid ColumnSpacing="14" Padding="0,8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource BorderSubtleBrush}"
                                      ToolTipService.ToolTip="{x:Bind Source}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock><Run Text="{x:Bind Name}" FontWeight="SemiBold" /> · <Run Text="{x:Bind Component}" /></TextBlock>
                                        <TextBlock Style="{StaticResource LabelTextStyle}"><Run Text="Source:" /> <Run Text="{x:Bind Source}" /> · <Run Text="{x:Bind Quality}" /></TextBlock>
                                        <TextBlock Text="{x:Bind Limit}" Style="{StaticResource LabelTextStyle}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Value}" Style="{StaticResource MetricValueTextStyle}" FontSize="22" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <c:CardHeader Title="Not available on this PC" Glyph="&#xE946;" Margin="0,0,0,4" />
                    <ItemsRepeater ItemsSource="{x:Bind Vm.Unavailable}">
                        <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{StaticResource MutedTextStyle}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <TextBlock Style="{StaticResource LabelTextStyle}" Text="A missing reading is preferable to unsafe access. Sentinel never installs kernel drivers or weakens Windows security to read a sensor." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</local:SentinelPage>
