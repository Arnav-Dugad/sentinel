<local:SentinelPage
    x:Class="Sentinel.App.Views.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sentinel.App.Views"
    xmlns:vm="using:Sentinel.App.ViewModels"
    xmlns:c="using:Sentinel.App.Controls">

    <Grid Padding="32,8,32,24" RowSpacing="12" MaxWidth="{StaticResource ContentMaxWidth}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,16,0,0" Spacing="8">
            <TextBlock Text="Processes" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="{x:Bind Vm.Totals, Mode=OneWay}" Style="{StaticResource PageSubtitleTextStyle}" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox PlaceholderText="Search apps and processes" Text="{x:Bind Vm.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxWidth="420" HorizontalAlignment="Left" MinWidth="240" />
            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Vm.GroupByApp, Mode=TwoWay}" OnContent="Grouped by app" OffContent="Individual processes" MinWidth="0" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition x:Name="DetailColumn" Width="2*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="0,8,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8" Padding="24,0,24,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <HyperlinkButton Content="Name" Click="OnSort" Tag="Name" Padding="0" />
                        <HyperlinkButton Grid.Column="1" Content="CPU" Click="OnSort" Tag="CPU" Padding="0" HorizontalAlignment="Right" />
                        <HyperlinkButton Grid.Column="2" Content="Memory" Click="OnSort" Tag="Memory" Padding="0" HorizontalAlignment="Right" />
                        <HyperlinkButton Grid.Column="3" Content="Disk" Click="OnSort" Tag="Disk" Padding="0" HorizontalAlignment="Right" />
                        <HyperlinkButton Grid.Column="4" Content="GPU" Click="OnSort" Tag="GPU" Padding="0" HorizontalAlignment="Right" />
                    </Grid>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Rows}" SelectedItem="{x:Bind Vm.Selected, Mode=TwoWay}" ItemContainerStyle="{StaticResource TableListViewItemStyle}"
                              AutomationProperties.Name="Processes">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProcessRow">
                                <Grid ColumnSpacing="8" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource LabelTextStyle}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Cpu, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Memory, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Disk, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Gpu, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="16">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{x:Bind Vm.Selected.Name, Mode=OneWay, FallbackValue='Select an app'}" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="{x:Bind Vm.Impact, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" />
                            <c:InfoList Items="{x:Bind Vm.Details, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource LabelTextStyle}" Text="Sentinel only observes. To close an app, use the app itself or Task Manager." />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Heaviest apps, last 24 hours" Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock Text="Not recorded while Privacy mode is on." Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind local:Bool.Vis(Vm.Privacy), Mode=OneWay}" />
                            <ItemsRepeater ItemsSource="{x:Bind Vm.History}">
                                <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AppRow">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Impact}" Style="{StaticResource LabelTextStyle}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Cpu}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</local:SentinelPage>
