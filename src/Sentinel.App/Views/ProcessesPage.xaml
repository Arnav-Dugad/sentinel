<local:SentinelPage
    x:Class="Sentinel.App.Views.ProcessesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sentinel.App.Views"
    xmlns:vm="using:Sentinel.App.ViewModels"
    xmlns:c="using:Sentinel.App.Controls">

    <Grid Padding="36,0,36,24" RowSpacing="16" MaxWidth="{StaticResource ContentMaxWidth}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <c:PageHeader Title="Processes" Subtitle="{x:Bind Vm.Totals, Mode=OneWay}" />
        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <AutoSuggestBox PlaceholderText="Search apps and processes" QueryIcon="Find" Text="{x:Bind Vm.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            MaxWidth="420" MinWidth="260" HorizontalAlignment="Left" AutomationProperties.Name="Search apps and processes" />
            <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Vm.GroupByApp, Mode=TwoWay}" OnContent="Grouped by app" OffContent="Individual processes" MinWidth="0" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition x:Name="DetailColumn" Width="2*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="0,8,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8" Padding="12,4,24,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="56" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource ColumnHeaderButtonStyle}" Click="OnSort" Tag="Name" Content="{x:Bind local:Text.SortHeader('Name', Vm.SortBy), Mode=OneWay}" />
                        <Button Grid.Column="1" Style="{StaticResource ColumnHeaderButtonStyle}" Click="OnSort" Tag="CPU" HorizontalAlignment="Right" Content="{x:Bind local:Text.SortHeader('CPU', Vm.SortBy), Mode=OneWay}" />
                        <Button Grid.Column="2" Style="{StaticResource ColumnHeaderButtonStyle}" Click="OnSort" Tag="Memory" HorizontalAlignment="Right" Content="{x:Bind local:Text.SortHeader('Memory', Vm.SortBy), Mode=OneWay}" />
                        <Button Grid.Column="3" Style="{StaticResource ColumnHeaderButtonStyle}" Click="OnSort" Tag="Disk" HorizontalAlignment="Right" Content="{x:Bind local:Text.SortHeader('Disk', Vm.SortBy), Mode=OneWay}" />
                        <Button Grid.Column="4" Style="{StaticResource ColumnHeaderButtonStyle}" Click="OnSort" Tag="GPU" HorizontalAlignment="Right" Content="{x:Bind local:Text.SortHeader('GPU', Vm.SortBy), Mode=OneWay}" />
                    </Grid>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind Vm.Rows}" SelectedItem="{x:Bind Vm.Selected, Mode=TwoWay}" ItemContainerStyle="{StaticResource TableListViewItemStyle}"
                              AutomationProperties.Name="Processes">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProcessRow">
                                <Grid ColumnSpacing="8" Padding="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Style="{StaticResource LabelTextStyle}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Cpu, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Memory, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Disk, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Gpu, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="16">
                    <Border Style="{StaticResource CardStyle}">
                        <Grid>
                            <c:EmptyState Glyph="&#xE7EF;" Title="Select an app" Message="Choose an app or process to see what it is, where it runs from and how much of this PC it uses."
                                          Visibility="{x:Bind local:Bool.Not(Vm.HasSelection), Mode=OneWay}" />
                            <StackPanel Spacing="12" Visibility="{x:Bind local:Bool.Vis(Vm.HasSelection), Mode=OneWay}">
                                <c:CardHeader Title="{x:Bind Vm.Selected.Name, Mode=OneWay, FallbackValue=''}" Glyph="&#xE7EF;" />
                                <TextBlock Text="{x:Bind Vm.Impact, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" Visibility="{x:Bind local:Bool.HasText(Vm.Impact), Mode=OneWay}" />
                                <c:InfoList Items="{x:Bind Vm.Details, Mode=OneWay}" />
                                <TextBlock Style="{StaticResource LabelTextStyle}" Text="Sentinel only observes. To close an app, use the app itself or Task Manager." />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="8">
                            <c:CardHeader Title="Heaviest apps, last 24 hours" Glyph="&#xE9D2;" />
                            <TextBlock Text="Not recorded while Privacy mode is on." Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind local:Bool.Vis(Vm.Privacy), Mode=OneWay}" />
                            <ItemsRepeater ItemsSource="{x:Bind Vm.History}">
                                <ItemsRepeater.Layout><StackLayout Spacing="8" /></ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AppRow">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Impact}" Style="{StaticResource LabelTextStyle}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Cpu}" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</local:SentinelPage>
