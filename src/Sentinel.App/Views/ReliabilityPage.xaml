<local:SentinelPage
    x:Class="Sentinel.App.Views.ReliabilityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Sentinel.App.Views"
    xmlns:vm="using:Sentinel.App.ViewModels"
    xmlns:c="using:Sentinel.App.Controls">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource ContentMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="20">
            <StackPanel Margin="0,16,0,0" Spacing="8">
                <TextBlock Text="Reliability" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="{x:Bind Vm.Summary, Mode=OneWay}" Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Last 30 days" Style="{StaticResource SectionTitleTextStyle}" />
                    <c:SentinelChart x:Name="Chart" Height="200" AutomationProperties.Name="Reliability events per day" />
                    <TextBlock Text="Events per day. Triangles mark stop errors." Style="{StaticResource LabelTextStyle}" />
                </StackPanel>
            </Border>

            <c:AdaptiveGrid MinItemWidth="400" MaxColumns="2" ColumnSpacing="16" RowSpacing="16">
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Summary" Style="{StaticResource SectionTitleTextStyle}" />
                        <c:InfoList Items="{x:Bind Vm.Counts, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Stop errors" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="None in the last 30 days." Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind local:Bool.Zero(Vm.StopErrors.Count), Mode=OneWay}" />
                        <ItemsRepeater ItemsSource="{x:Bind Vm.StopErrors}">
                            <ItemsRepeater.Layout><StackLayout Spacing="12" /></ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="vm:StopErrorRow">
                                    <Border Style="{StaticResource SunkenPanelStyle}">
                                        <StackPanel Spacing="4">
                                            <TextBlock><Run Text="{x:Bind Name}" FontWeight="SemiBold" /> <Run Text="{x:Bind Code}" Foreground="{ThemeResource TextSecondaryBrush}" /></TextBlock>
                                            <TextBlock Style="{StaticResource LabelTextStyle}"><Run Text="{x:Bind Time}" /> · <Run Text="{x:Bind Category}" /></TextBlock>
                                            <TextBlock Text="{x:Bind Explanation}" Style="{StaticResource MutedTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <TextBlock Style="{StaticResource LabelTextStyle}" Text="Explanations describe what a stop code usually means; they never single out a defective component. Memory dumps stay on your PC." />
                    </StackPanel>
                </Border>
            </c:AdaptiveGrid>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Applications" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Text="No application crashes or hangs in the last 30 days." Style="{StaticResource MutedTextStyle}" Visibility="{x:Bind local:Bool.Zero(Vm.Apps.Count), Mode=OneWay}" />
                    <ItemsRepeater ItemsSource="{x:Bind Vm.Apps}">
                        <ItemsRepeater.Layout><StackLayout Spacing="2" /></ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppCrashRow">
                                <Grid ColumnSpacing="16" Padding="0,7" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource BorderSubtleBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind App}" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Module}" Style="{StaticResource LabelTextStyle}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind Counts}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{x:Bind Last}" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="8">
                    <Grid>
                        <TextBlock Text="Events" Style="{StaticResource SectionTitleTextStyle}" />
                        <HyperlinkButton Content="Open in Timeline for details" HorizontalAlignment="Right" Click="OnTimeline" Padding="4,0" />
                    </Grid>
                    <ItemsRepeater ItemsSource="{x:Bind Vm.Events}">
                        <ItemsRepeater.Layout><StackLayout Spacing="2" /></ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:EventRow">
                                <Grid ColumnSpacing="12" Padding="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Time}" Style="{StaticResource MutedTextStyle}" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource LabelTextStyle}" TextWrapping="Wrap" MaxLines="2" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</local:SentinelPage>
